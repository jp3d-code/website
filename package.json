    "marked": "^18.0.4",
    "motion": "^12.40.0",
    "next": "16.2.4",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "payload": "3.84.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "resend": "^6.17.2",
    "shadcn": "^4.6.0",
    "sharp": "0.34.5",
