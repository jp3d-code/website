DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
SEED_TOKEN=YOUR_SEED_TOKEN_HERE
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP Configuration (For email notifications - Phase 4)
# For production/staging (e.g. Ethereal):
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your-ethereal-user@ethereal.email
# SMTP_PASS=your-ethereal-password

# For local development with Mailpit (run `docker compose -f docker-compose.dev.yaml up -d`):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev_user
SMTP_PASS=dev_pass
BUSINESS_EMAIL=cotizaciones@jp3d.com
FROM_EMAIL=no-reply@jp3d.com
